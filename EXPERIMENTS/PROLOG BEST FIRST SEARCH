best_first(Start, Goal, Path) :-
    search([[Start]], Goal, RevPath),
    reverse(RevPath, Path).

search([[Goal|Rest]|_], Goal, [Goal|Rest]).

search([Path|Paths], Goal, Result) :-
    Path = [Current|_],
    findall([Next|Path],
        (edge(Current, Next, _),
         \+ member(Next, Path)),
        NewPaths),
    append(Paths, NewPaths, AllPaths),
    sort_paths(AllPaths, Sorted),
    search(Sorted, Goal, Result).

sort_paths(Paths, Sorted) :-
    map_list_to_pairs(path_heuristic, Paths, Pairs),
    keysort(Pairs, SortedPairs),
    pairs_values(SortedPairs, Sorted).

path_heuristic([Node|_], H) :-
    heuristic(Node, H).

